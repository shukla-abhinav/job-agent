# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
PROFILE_PATH=../data/profile.md
PREFERENCES_PATH=../data/preferences.md
# Get a free SerpAPI key at https://serpapi.com (100 searches/month free)
SERPAPI_KEY=your_serpapi_key_here
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# JWT secret key — use a long random string in production
SECRET_KEY=your-long-random-secret-key-here
# Comma-separated list of allowed CORS origins (add your Vercel frontend URL here)
# Example: https://my-app.vercel.app,https://my-app-git-main-username.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
